+test("private tee drain finishes after the downstream branch is cancelled", async () => {
+  let sent = 0;
+  const source = new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      if (sent === 4) {
+        controller.close();
+        return;
+      }
+      await new Promise((resolve) => setTimeout(resolve, 2));
+      controller.enqueue(Uint8Array.of(++sent));
+    },
+  });
+  const [downstream, privateBranch] = source.tee();
+  const drained = drainCodexImageArtifactStream(privateBranch);
+  await downstream.cancel("client timeout");
+  assert.equal(await drained, null);
+  assert.equal(sent, 4);
+});
+
+test("private tee returns a complete JSON response after downstream cancellation", async () => {
+  const png = tinyPng();
+  const response = JSON.stringify({
+    id: "resp_live",
+    object: "response",
+    output: [
+      {
+        id: "ig_live",
+        type: "image_generation_call",
+        output_format: "png",
+        result: png.toString("base64"),
+      },
+    ],
+  });
+  const bytes = Buffer.from(response);
+  let offset = 0;
+  const source = new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (offset >= bytes.length) {
+        controller.close();
+        return;
+      }
+      const end = Math.min(offset + 7, bytes.length);
+      controller.enqueue(bytes.subarray(offset, end));
+      offset = end;
+    },
+  });
+  const [downstream, privateBranch] = source.tee();
+  const captured = drainCodexImageArtifactStream(privateBranch);
+  await downstream.cancel("client timeout");
+  assert.deepEqual(await captured, JSON.parse(response));
+});
+
+test("private tee extracts response.completed from SSE across chunk boundaries", async () => {
+  const response = {
+    id: "resp_sse",
+    object: "response",
+    output: [
+      {
+        id: "ig_sse",
+        type: "image_generation_call",
+        output_format: "png",
+        result: tinyPng().toString("base64"),
+      },
+    ],
+  };
+  const bytes = Buffer.from(
+    `event: response.created\ndata: ${JSON.stringify({ type: "response.created" })}\n\n` +
+      `event: response.completed\ndata: ${JSON.stringify({ type: "response.completed", response })}\n\n` +
+      "data: [DONE]\n\n"
+  );
+  const stream = new ReadableStream<Uint8Array>({
+    start(controller) {
+      for (let offset = 0; offset < bytes.length; offset += 11) {
+        controller.enqueue(bytes.subarray(offset, offset + 11));
+      }
+      controller.close();
+    },
+  });
+  assert.deepEqual(await drainCodexImageArtifactStream(stream), response);
+});
