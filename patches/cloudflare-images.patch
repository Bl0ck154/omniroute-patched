index 0000000..95224c0
--- /dev/null
+++ b/tests/unit/cloudflare-workers-ai-image.test.ts
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  buildCloudflareWorkersAiImageInput,
+  extractCloudflareWorkersAiImage,
+  resolveCloudflareWorkersAiAccountId,
+} from "../../open-sse/handlers/imageGeneration/providers/cloudflareWorkersAi.ts";
+
+test("Cloudflare image adapter resolves account ID from provider-specific credentials", () => {
+  assert.equal(
+    resolveCloudflareWorkersAiAccountId({
+      apiKey: "test",
+      providerSpecificData: { accountId: "account-123" },
+    }),
+    "account-123"
+  );
+});
+
+test("Cloudflare image adapter builds the narrow Workers AI payload", () => {
+  assert.deepEqual(
+    buildCloudflareWorkersAiImageInput(
+      { prompt: "cat", steps: 99, seed: 41, size: "1024x1024", response_format: "url" },
+      1
+    ),
+    { prompt: "cat", steps: 8, seed: 42 }
+  );
+});
+
+test("Cloudflare image adapter extracts the REST API image envelope", () => {
+  assert.equal(
+    extractCloudflareWorkersAiImage({ success: true, result: { image: "YWJj" } }),
+    "YWJj"
+  );
+  assert.equal(extractCloudflareWorkersAiImage({ result: {} }), null);
+});
